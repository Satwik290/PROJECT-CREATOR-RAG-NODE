# ==============================================================================
# PROJECT-CREATOR-RAG-NODE Backend Configuration Template
# Copy this file to '.env' and populate with your actual keys and config values.
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Get your Gemini API key at https://aistudio.google.com/
# Tip: Provide multiple API keys separated by commas to avoid 429 rate limits.
# e.g. GEMINI_API_KEY=key1,key2,key3  — system auto-rotates on rate limits.
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database Configuration
# If running Qdrant locally via docker-compose: http://localhost:6333
QDRANT_URL=http://localhost:6333

# Redis Cache Configuration
# If running Redis locally via docker-compose: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Instagram Metadata Enrichment (Optional — set at least ONE for real data)
# ==============================================================================

# Option A (RECOMMENDED): RapidAPI Instagram Scraper API
# Sign up FREE at: https://rapidapi.com/social-api1-instagram/api/instagram-scraper-api2
# Free tier: 50 requests/month | Paid: ~$0.001/request
# This is the most reliable way to get real views, likes, and follower counts.
RAPIDAPI_KEY=your_rapidapi_key_here

# Option B: Instagram session cookie (single authenticated account)
# 1. Log into Instagram in Chrome → F12 → Application → Cookies → copy `sessionid` value
# 2. Not production-grade but unblocks local demo testing
INSTAGRAM_SESSION_ID=your_instagram_session_id_here
