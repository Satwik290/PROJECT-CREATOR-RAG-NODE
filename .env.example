# ==============================================================================
# PROJECT-CREATOR-RAG-NODE Root Configuration Template
# Copy this file to '.env' and populate with your actual keys and config values.
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# LLM & Transcription Providers
# Get your Groq API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_key

# Get your Gemini API key at https://aistudio.google.com/
# High-volume/Free tier tip: To prevent 429 rate limit errors, you can provide multiple API keys separated by commas (e.g. key1,key2,key3). The system will rotate through them automatically on rate limits.
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database Configuration
# If running Qdrant locally via docker-compose: http://localhost:6333
# If using Qdrant Cloud, this should be the cluster URL
QDRANT_URL=http://localhost:6333

# Redis Cache Configuration
# If running Redis locally via docker-compose: redis://localhost:6379
REDIS_URL=redis://localhost:6379
